{
  "id": "hosted-json-example",
  "title": "Hosted JSON example (no CMS)",
  "theme": {
    "primaryColor": "#6C4CF1",
    "font": "Manrope",
    "background": "#F6F5FB",
    "stepper": true
  },
  "variantParam": "angle",
  "destination": "https://mate.academy/courses?session={{sessionId}}&goal={{interests}}",
  "variants": {
    "default": {
      "copy": {
        "heroBadge": "🛰️ Served from a static quiz.json",
        "heroTitle": "Find your perfect IT career path",
        "heroSubtitle": "Answer a few quick questions and get a personalized plan to land your first job in tech.",
        "heroCta": "Start the quiz"
      },
      "screens": [
        "hero",
        "name",
        "experience",
        "reassure",
        "interests",
        "vibe-check",
        "loader",
        "email",
        "result"
      ]
    },
    "switch": {
      "copy": {
        "heroBadge": "🔁 For career switchers",
        "heroTitle": "Outgrown your current job?",
        "heroSubtitle": "See which IT career fits the skills you already have — and switch in under a year.",
        "heroCta": "Check my fit"
      },
      "screens": [
        "hero",
        "switch-reason",
        "name",
        "experience",
        "reassure",
        "interests",
        "vibe-check",
        "loader",
        "email",
        "result"
      ]
    }
  },
  "screens": [
    {
      "id": "hero",
      "type": "hero",
      "badge": "{{variant.heroBadge}}",
      "title": "{{variant.heroTitle}}",
      "subtitle": "{{variant.heroSubtitle}}",
      "cta": "{{variant.heroCta}}",
      "emoji": "💻"
    },
    {
      "id": "switch-reason",
      "type": "single-select",
      "layout": "list",
      "saveAs": "switchReason",
      "title": "What makes you want to switch?",
      "options": [
        {
          "label": "Low salary ceiling",
          "icon": "💸"
        },
        {
          "label": "No growth left",
          "icon": "📉"
        },
        {
          "label": "Burnout",
          "icon": "🔥"
        },
        {
          "label": "Just curious about IT",
          "icon": "👀"
        }
      ]
    },
    {
      "id": "name",
      "type": "text",
      "saveAs": "name",
      "title": "First — what should we call you?",
      "subtitle": "We’ll personalize your plan.",
      "placeholder": "Your name",
      "cta": "Continue"
    },
    {
      "id": "experience",
      "type": "single-select",
      "layout": "cards",
      "saveAs": "experience",
      "title": "Hey {{name|there}}! Have you tried coding before?",
      "options": [
        {
          "label": "Never",
          "icon": "🌱"
        },
        {
          "label": "A little",
          "icon": "🧩"
        },
        {
          "label": "Quite a bit",
          "icon": "🚀"
        }
      ],
      "next": [
        {
          "when": {
            "var": "experience",
            "op": "eq",
            "value": "Never"
          },
          "goto": "reassure"
        },
        {
          "goto": "interests"
        }
      ]
    },
    {
      "id": "reassure",
      "type": "message",
      "show": {
        "var": "experience",
        "op": "eq",
        "value": "Never"
      },
      "emoji": "💜",
      "title": "Perfect starting point, {{name|friend}}",
      "text": "67% of Mate academy grads started with zero experience. Your plan will begin from the absolute basics — no background needed.",
      "cta": "Good to know"
    },
    {
      "id": "interests",
      "type": "multi-select",
      "layout": "list",
      "saveAs": "interests",
      "title": "What sounds exciting to you?",
      "hint": "Pick as many as you like",
      "options": [
        {
          "label": "Building websites",
          "icon": "🖥️"
        },
        {
          "label": "Analyzing data",
          "icon": "📊"
        },
        {
          "label": "Designing interfaces",
          "icon": "🎨"
        },
        {
          "label": "Automating tests",
          "icon": "🤖"
        },
        {
          "label": "Managing products",
          "icon": "🧭"
        }
      ],
      "cta": "Next"
    },
    {
      "id": "vibe-check",
      "type": "message",
      "emoji": "⚡",
      "title": "Nice picks, {{name|friend}}!",
      "conditionalText": [
        {
          "when": {
            "var": "interests",
            "op": "contains",
            "value": "Designing interfaces"
          },
          "text": "A creative eye + tech = UI/UX design is calling. Mate design grads land their first job in ~9 months."
        },
        {
          "when": {
            "var": "interests",
            "op": "contains",
            "value": "Analyzing data"
          },
          "text": "Data analysts are among the most in-demand hires of 2026. Great instinct."
        }
      ],
      "text": "Hands-on builders like you thrive fastest in practical tech roles.",
      "cta": "Show me my path"
    },
    {
      "id": "loader",
      "type": "loader",
      "delayMs": 4000,
      "title": "Building your career plan…",
      "steps": [
        "Analyzing your answers",
        "Matching career paths",
        "Checking job-market demand",
        "Finalizing your plan"
      ]
    },
    {
      "id": "email",
      "type": "email",
      "saveAs": "email",
      "title": "{{name|Friend}}, your plan is ready",
      "subtitle": "Where should we send it?",
      "placeholder": "you@example.com",
      "privacy": "We only use your email to send your career plan. No spam, ever.",
      "cta": "Get my plan"
    },
    {
      "id": "result",
      "type": "result",
      "emoji": "🎉",
      "title": "{{name|Friend}}, you’re a great fit for IT",
      "subtitle": "Based on your answers, here’s your starting roadmap.",
      "items": [
        {
          "label": "Experience level",
          "value": "{{experience|—}}"
        },
        {
          "label": "Your interests",
          "value": "{{interests|—}}"
        },
        {
          "label": "First milestone",
          "value": "Job-ready in ~10 months"
        }
      ],
      "cta": "Get my full plan →",
      "redirect": true
    }
  ]
}